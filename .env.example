POSTHOG_API_KEY=
SECRET_KEY=
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
GOOGLE_BOOKS_API_KEY=

# LLM chain (vibe + publisher research) through LiteLLM.
# At least one key is required. Default chain is:
#   groq/openai/gpt-oss-120b -> groq/qwen/qwen3.8-27b -> gemini/gemini-flash-lite-latest
GROQ_API_KEY=
GEMINI_API_KEY=
# Optional overrides.
# LLM_MODELS=gemini/gemini-flash-lite-latest
# LLM_TIMEOUT_SECONDS=20
# LLM_NUM_RETRIES=1

# DEBUG defaults to False. Django refuses to boot with DEBUG=True unless
# DJANGO_ENV is one of {development, test, ci}. Set both explicitly for
# local dev; set DJANGO_ENV=production (and leave DEBUG unset or False)
# in production.
DJANGO_ENV=development
DEBUG=True

# Optional if you are running without docker
# DATABASE_URL=postgres://bibliotype_user:yoursecurepassword123@127.0.0.1:5432/bibliotype_db

# CELERY_BROKER_URL=redis://127.0.0.1:6379/0
# CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0

# Set to True to enable Django Silk profiling at /silk/ (local development only).
# Off by default to avoid the runtime overhead and DB writes Silk does on every request.
# ENABLE_SILK=True

# Feature flag for the parallel book-enrichment fast path. Default
# False. Keeps the conservative per-call sleep that throttles Open Library
# and Google Books. Flip to True only after confirming external API rate-limit
# headroom.
#
# Celery's worker-side rate_limit="60/m" on enrich_book_task is
# in place either way.
# ENABLE_PARALLEL_ENRICHMENT=False
# Optional: hosts + cache/broker (Docker compose sets these)
# ALLOWED_HOSTS=localhost,127.0.0.1
# REDIS_CACHE_URL=redis://127.0.0.1:6379/1

# Optional: email (SMTP. Defaults to smtp-relay.brevo.com, empty creds) 
# EMAIL_HOST=
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=

# Optional: Cloudflare Turnstile CAPTCHA (unset = CAPTCHA disabled)
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
